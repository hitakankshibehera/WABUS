# MargPath / wABus Environment Variables & SMS Gateway Configuration

# -------------------------------------------------------------
# SMS Gateway Options (Add your API key for direct SMS delivery)
# -------------------------------------------------------------

# Option 1: 2Factor.in (Instant SMS OTP in India)
TWOFACTOR_API_KEY=your_2factor_api_key_here

# Option 2: Fast2SMS (Indian Bulk SMS & OTP Gateway)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 3: MSG91 OTP API
MSG91_AUTH_KEY=your_msg91_auth_key_here

# Option 4: Twilio SMS Gateway
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Option 5: Textlocal SMS Gateway
TEXTLOCAL_API_KEY=your_textlocal_api_key

# Option 6: WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# -------------------------------------------------------------
# SMTP Email Settings (Gmail SSL Port 465)
# -------------------------------------------------------------
EMAIL_USER=wonderlightadventure@gmail.com
EMAIL_PASSWORD=yvlf rizi yibe ieny
